<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".HomeFragment">

    <!-- LAWAS IMAGE CAROUSEL -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerLawas"
        android:layout_width="0dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark overlay -->
    <View
        android:id="@+id/lawasOverlay"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="#30000000"
        app:layout_constraintTop_toTopOf="@id/viewPagerLawas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fade photo into black -->
    <View
        android:id="@+id/lawasFade"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@drawable/lawas_fade"
        app:layout_constraintBottom_toBottomOf="@id/viewPagerLawas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Name -->
    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAWAS EVENTIA"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="cursive"
        android:gravity="center"
        android:layout_marginBottom="88dp"
        app:layout_constraintBottom_toBottomOf="@id/viewPagerLawas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Information -->
    <TextView
        android:id="@+id/txtAppInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discover events in Lawas"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:layout_marginBottom="68dp"
        app:layout_constraintBottom_toBottomOf="@id/viewPagerLawas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lawas image indicators -->
    <LinearLayout
        android:id="@+id/lawasIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/viewPagerLawas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- UPCOMING EVENTS -->
    <TextView
        android:id="@+id/txtUpcoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upcoming Events"
        android:textColor="@color/white"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/viewPagerLawas"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- PREVIOUS EVENT BUTTON -->
    <ImageButton
        android:id="@+id/btnEventPrevious"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Previous event"
        android:src="@drawable/arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewPagerEvents"
        app:layout_constraintBottom_toBottomOf="@id/viewPagerEvents" />

    <!-- EVENT POSTERS -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerEvents"
        android:layout_width="240dp"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/txtUpcoming"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NEXT EVENT BUTTON -->
    <ImageButton
        android:id="@+id/btnEventNext"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next event"
        android:src="@drawable/arrow_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewPagerEvents"
        app:layout_constraintBottom_toBottomOf="@id/viewPagerEvents" />

    <!-- EVENT SWIPE INDICATORS -->
    <LinearLayout
        android:id="@+id/eventIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/viewPagerEvents"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EVENT TITLE -->
    <TextView
        android:id="@+id/txtHomeEventTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/eventIndicators"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EVENT DATE -->
    <TextView
        android:id="@+id/txtHomeEventDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:textColor="#D0D0D0"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/txtHomeEventTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
